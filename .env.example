# Modo de datos: "mock" (MSW) o "real" (backend Odoo vía proxy).
# Sin setear, el default depende del entorno: "mock" en desarrollo, "real" en
# un build de producción — así un deploy al que se le olvidó la variable no
# sirve una API falsa. Para desplegar una demo sin backend, poné "mock" acá
# de forma explícita.
VITE_API_MODE=mock

# Prefijo del contrato de API (doc 04).
VITE_API_BASE_URL=/api/v1

# Destino del proxy de Vite cuando VITE_API_MODE=real (ADR-005, same-origin en prod).
VITE_ODOO_URL=http://localhost:8069
